# Any OpenAI-compatible endpoint
DEEPTRACE_API_KEY=
DEEPTRACE_MODEL=gpt-4o-mini
DEEPTRACE_BASE_URL=https://api.openai.com/v1

# docker-compose searches the bundled example corpus by default. Point
# DEEPTRACE_CORPUS at another folder mounted into the containers, or add
# "--web" to the commands in docker-compose.yml and set TAVILY_API_KEY.
TAVILY_API_KEY=
